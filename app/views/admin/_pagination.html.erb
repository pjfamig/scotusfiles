<% if @page > 1 || @next_page %>
  <nav class="mt-6 flex items-center justify-between text-sm" aria-label="Pagination">
    <% if @page > 1 %>
      <%= link_to "← Newer", url_for(request.query_parameters.merge(page: @page - 1)), class: "font-medium text-accent-600 hover:underline underline-offset-4 dark:text-accent-400" %>
    <% else %>
      <span></span>
    <% end %>
    <span class="text-neutral-500 dark:text-neutral-400">Page <%= @page %></span>
    <% if @next_page %>
      <%= link_to "Older →", url_for(request.query_parameters.merge(page: @next_page)), class: "font-medium text-accent-600 hover:underline underline-offset-4 dark:text-accent-400" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
