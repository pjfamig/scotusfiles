<div class="<%= admin_card_classes %> p-5">
  <p class="text-sm text-neutral-500 dark:text-neutral-400"><%= label %></p>
  <p class="mt-2 text-3xl font-bold tracking-tight tabular-nums"><%= number_with_delimiter(value) %></p>
  <p class="mt-1 text-xs <%= local_assigns[:alert] ? "font-medium text-red-600 dark:text-red-300" : "text-neutral-500 dark:text-neutral-400" %>"><%= detail %></p>
</div>
