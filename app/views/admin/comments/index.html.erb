<div class="mx-auto max-w-[90rem] px-4 py-10 lg:px-8">
  <%= render "admin/header", title: "Comments" %>

  <% if @user %>
    <p class="mt-6 text-sm text-neutral-600 dark:text-neutral-400">
      Showing comments by <span class="font-semibold text-neutral-950 dark:text-white"><%= @user.name %></span> (<%= @user.email_address %>).
      <%= link_to "Show everyone’s", admin_comments_path, class: "text-accent-600 hover:underline underline-offset-4 dark:text-accent-400" %>
    </p>
  <% end %>

  <ul class="<%= admin_card_classes %> mt-6 divide-y divide-neutral-200 dark:divide-neutral-800">
    <% @comments.each do |comment| %>
      <li id="<%= dom_id(comment) %>" class="flex gap-4 px-5 py-4">
        <span class="<%= avatar_classes(comment.user) %> flex size-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold"><%= comment.user.initials %></span>
        <div class="min-w-0 flex-1 text-sm">
          <p class="flex flex-wrap items-center gap-x-2 text-xs text-neutral-500 dark:text-neutral-400">
            <%= link_to comment.user.name, admin_comments_path(user_id: comment.user_id), class: "font-semibold text-neutral-950 hover:underline underline-offset-4 dark:text-white" %>
            on <%= link_to comment.decision.title, decision_path(comment.decision, anchor: comment.passage&.anchor), class: "hover:underline underline-offset-4" %>
            · <%= admin_time comment.created_at %>
          </p>
          <% if comment.passage %>
            <p class="mt-2 border-l-2 border-neutral-300 pl-3 text-neutral-500 italic dark:border-neutral-700 dark:text-neutral-400">“<%= truncate(comment.passage.text, length: 160, separator: " ") %>”</p>
          <% end %>
          <p class="mt-2 whitespace-pre-line text-neutral-800 dark:text-neutral-200"><%= comment.body %></p>
        </div>
        <%= button_to "Delete", decision_comment_path(comment.decision, comment), method: :delete,
              form: { data: { turbo_confirm: "Delete this comment by #{comment.user.name}?" } },
              class: "shrink-0 cursor-pointer self-start rounded-md px-2 py-1 text-xs font-medium text-neutral-500 transition-colors duration-150 hover:bg-red-50 hover:text-red-700 dark:text-neutral-400 dark:hover:bg-red-950 dark:hover:text-red-300" %>
      </li>
    <% end %>
  </ul>
  <% if @comments.empty? %><p class="mt-6 text-center text-sm text-neutral-500">No comments yet.</p><% end %>

  <%= render "admin/pagination" %>
</div>
