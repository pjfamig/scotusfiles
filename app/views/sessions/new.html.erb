<% content_for :title, "Sign in" %>
<% noindex! %>
<%= auth_card title: "Welcome back", subtitle: "Sign in to join the discussion." do %>
  <%= form_with url: session_path, class: "space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: field_classes %>
    </div>
    <div>
      <div class="flex items-center justify-between">
        <%= form.label :password, class: "text-sm font-medium" %>
        <%= link_to "Forgot password?", new_password_path, class: "text-xs text-accent-600 hover:underline dark:text-accent-400" %>
      </div>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: field_classes %>
    </div>
    <%= form.submit "Sign in", class: primary_button_classes %>
  <% end %>
  <p class="mt-6 text-center text-sm text-neutral-500 dark:text-neutral-400">
    New here? <%= link_to "Create an account", new_registration_path, class: "font-semibold text-accent-600 hover:underline dark:text-accent-400" %>
  </p>
<% end %>
