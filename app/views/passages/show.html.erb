<%= turbo_frame_tag "passage_panel" do %>
  <div class="p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs font-semibold tracking-[0.2em] text-accent-600 uppercase dark:text-accent-400">Selected passage</p>
      <button type="button" data-action="reader#close" class="cursor-pointer rounded-md p-1 text-neutral-400 transition-colors duration-150 hover:bg-neutral-100 hover:text-neutral-950 dark:hover:bg-neutral-800 dark:hover:text-white" aria-label="Close and show all discussion">
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>

    <blockquote class="mt-3 rounded-r-lg border-l-[3px] border-[var(--hl-ink)] bg-[color-mix(in_oklab,var(--hl)_25%,transparent)] py-2 pr-3 pl-4 text-[0.95rem] leading-relaxed text-neutral-800 dark:text-neutral-200">
      <%= @passage.text %>
    </blockquote>
    <% if @passage.opinion %>
      <p class="mt-2 pl-4 text-xs text-neutral-500 dark:text-neutral-400">— <%= @passage.opinion.title %></p>
    <% end %>

    <h3 class="mt-6 text-sm font-semibold">Comments</h3>
    <ol id="<%= dom_id(@passage, :comments) %>" class="peer mt-3 space-y-4"><%= render partial: "comments/comment", collection: @comments %></ol>
    <p class="mt-2 hidden text-sm text-neutral-500 peer-empty:block dark:text-neutral-400">No comments on this passage yet.</p>

    <% if current_user %>
      <%= render "comments/form", decision: @decision, passage: @passage, comment: Comment.new %>
    <% else %>
      <div class="mt-5 rounded-xl bg-neutral-50 px-4 py-4 text-sm text-neutral-600 dark:bg-neutral-800/60 dark:text-neutral-300">
        <%= link_to "Sign in", new_session_path, data: { turbo_frame: "_top" }, class: "font-semibold text-accent-600 hover:underline dark:text-accent-400" %>
        or
        <%= link_to "create an account", new_registration_path, data: { turbo_frame: "_top" }, class: "font-semibold text-accent-600 hover:underline dark:text-accent-400" %>
        to comment on this passage.
      </div>
    <% end %>
  </div>
<% end %>
