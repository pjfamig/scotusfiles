<%= turbo_frame_tag "passage_panel" do %>
  <div class="p-5">
    <div class="flex items-center justify-between gap-3">
      <p class="text-xs font-semibold tracking-[0.2em] text-gold-600 uppercase dark:text-gold-400">Selected passage</p>
      <button type="button" data-action="reader#close" class="rounded-md p-1 text-stone-400 hover:bg-stone-100 hover:text-stone-700 dark:hover:bg-white/10 dark:hover:text-white" aria-label="Close and show all discussion">
        <svg class="size-5" viewBox="0 0 20 20" fill="currentColor"><path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/></svg>
      </button>
    </div>

    <blockquote class="mt-3 border-l-2 border-gold-400 pl-4 font-serif text-[0.95rem] leading-relaxed text-stone-700 dark:text-stone-200">
      <%= @passage.text %>
    </blockquote>
    <% if @passage.opinion %>
      <p class="mt-2 pl-4 text-xs text-stone-500 dark:text-stone-400">— <%= @passage.opinion.title %></p>
    <% end %>

    <h3 class="mt-6 text-sm font-semibold">Comments</h3>
    <ol id="<%= dom_id(@passage, :comments) %>" class="peer mt-3 space-y-4"><%= render partial: "comments/comment", collection: @comments %></ol>
    <p class="mt-2 hidden text-sm text-stone-500 peer-empty:block dark:text-stone-400">No comments on this passage yet.</p>

    <% if current_user %>
      <%= render "comments/form", decision: @decision, passage: @passage, comment: Comment.new %>
    <% else %>
      <div class="mt-5 rounded-xl bg-stone-50 px-4 py-4 text-sm text-stone-600 dark:bg-white/5 dark:text-stone-300">
        <%= link_to "Sign in", new_session_path, data: { turbo_frame: "_top" }, class: "font-semibold text-navy-600 hover:underline dark:text-gold-300" %>
        or
        <%= link_to "create an account", new_registration_path, data: { turbo_frame: "_top" }, class: "font-semibold text-navy-600 hover:underline dark:text-gold-300" %>
        to comment on this passage.
      </div>
    <% end %>
  </div>
<% end %>
