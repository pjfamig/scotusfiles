<% content_for :title, "Create an account" %>
<%= auth_card title: "Join SCOTUSfiles", subtitle: "Comment on any sentence of any Supreme Court opinion." do %>
  <%= form_with model: @user, url: registration_path, class: "space-y-5" do |form| %>
    <% if @user.errors.any? %>
      <div class="border border-red-600 px-4 py-3 text-sm text-red-700 dark:text-red-400">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>
    <div>
      <%= form.label :name, "Display name", class: "text-sm font-medium" %>
      <%= form.text_field :name, required: true, autofocus: true, autocomplete: "name", maxlength: 60, class: field_classes %>
    </div>
    <div>
      <%= form.label :email_address, "Email", class: "text-sm font-medium" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: field_classes %>
    </div>
    <div>
      <%= form.label :password, class: "text-sm font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: field_classes %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm password", class: "text-sm font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
    </div>
    <%= form.submit "Create account", class: primary_button_classes %>
  <% end %>
  <p class="mt-6 text-center text-sm text-neutral-500 dark:text-neutral-400">
    Already have an account? <%= link_to "Sign in", new_session_path, class: "font-semibold text-neutral-950 underline underline-offset-4 dark:text-white" %>
  </p>
<% end %>
