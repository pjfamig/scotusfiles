<details id="highlight_picker" class="relative" data-controller="highlight" data-action="click@window->highlight#closeOnOutsideClick keydown.esc@window->highlight#close">
  <summary class="flex cursor-pointer list-none items-center rounded-md p-2 text-neutral-500 transition-colors duration-150 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white [&::-webkit-details-marker]:hidden" aria-label="Choose highlight color">
    <span class="size-4 rounded-full bg-[var(--hl)] ring-1 ring-black/10 dark:ring-white/20"></span>
  </summary>

  <div class="absolute right-0 z-40 mt-2 w-64 rounded-xl border border-neutral-200 bg-white p-4 shadow-lg dark:border-neutral-800 dark:bg-neutral-900">
    <p class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Highlight color</p>
    <div class="mt-3 flex flex-wrap gap-2">
      <% User::HIGHLIGHT_COLORS.each do |color| %>
        <%= button_to highlight_color_path, method: :patch, params: { highlight_color: color },
              form: { class: "contents" },
              data: { highlight: color, action: "highlight#preview", highlight_color_param: color },
              aria: { label: color.capitalize, pressed: current_user.highlight_color == color },
              title: color.capitalize,
              class: "size-7 cursor-pointer rounded-full bg-[var(--hl)] ring-1 ring-black/10 transition duration-150 hover:scale-110 aria-pressed:ring-2 aria-pressed:ring-neutral-950 aria-pressed:ring-offset-2 dark:ring-white/20 dark:ring-offset-neutral-900 dark:aria-pressed:ring-white" do %>
          <span class="sr-only"><%= color.capitalize %></span>
        <% end %>
      <% end %>
    </div>
    <p class="mt-3 text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">Used when you select or hover over a sentence.</p>
  </div>
</details>
