<div class="mx-auto max-w-md px-4 py-16 sm:py-24">
  <div class="rounded-2xl bg-white p-8 shadow-sm ring-1 ring-stone-200 dark:bg-white/5 dark:ring-white/10">
    <h1 class="font-serif text-3xl font-semibold tracking-tight"><%= title %></h1>
    <% if subtitle %>
      <p class="mt-2 text-sm text-stone-500 dark:text-stone-400"><%= subtitle %></p>
    <% end %>
    <div class="mt-8"><%= yield %></div>
  </div>
</div>
