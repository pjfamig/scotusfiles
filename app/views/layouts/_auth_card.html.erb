<div class="mx-auto max-w-md px-4 py-16 sm:py-24">
  <div class="border border-neutral-950 bg-white p-8 dark:border-neutral-700 dark:bg-neutral-950">
    <h1 class="text-2xl font-bold tracking-tight"><%= title %></h1>
    <% if subtitle %>
      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400"><%= subtitle %></p>
    <% end %>
    <div class="mt-8"><%= yield %></div>
  </div>
</div>
