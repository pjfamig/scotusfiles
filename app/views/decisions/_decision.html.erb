<li id="<%= dom_id(decision) %>" class="group relative grid gap-x-8 gap-y-2 py-6 sm:grid-cols-[7rem_minmax(0,1fr)_auto]">
  <div class="text-sm text-stone-500 tabular-nums dark:text-stone-400">
    <% if decision.decided_on %>
      <time datetime="<%= decision.decided_on.iso8601 %>"><%= decision.decided_on.strftime("%b %-d, %Y") %></time>
    <% end %>
  </div>

  <div class="min-w-0">
    <h3 class="font-serif text-xl leading-snug font-semibold tracking-tight">
      <%= link_to decision_path(decision), data: { turbo_frame: "_top" }, class: "after:absolute after:inset-0 group-hover:text-navy-600 dark:group-hover:text-gold-300" do %>
        <%= decision.title %>
      <% end %>
    </h3>
    <p class="mt-1 flex flex-wrap items-center gap-x-2 text-sm text-stone-500 dark:text-stone-400">
      <span>No. <%= decision.docket_number %></span>
      <span aria-hidden="true">·</span>
      <span><%= decision.per_curiam? ? "Per curiam" : "Opinion by Justice #{decision.author_name}" %></span>
      <% if decision.official_citation %>
        <span aria-hidden="true">·</span>
        <span><%= decision.official_citation %></span>
      <% end %>
    </p>
    <% if decision.holding %>
      <p class="mt-3 line-clamp-3 max-w-4xl leading-relaxed text-stone-700 dark:text-stone-300"><%= decision.holding %></p>
    <% end %>
  </div>

  <div class="flex items-start gap-2 sm:justify-end">
    <%= render "decisions/status_badge", decision: decision %>
    <% if decision.comments_count.positive? %>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-gold-200/60 px-2.5 py-1 text-xs font-semibold text-gold-600 dark:bg-gold-400/15 dark:text-gold-300">
        <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M4.8 3h14.4A1.8 1.8 0 0 1 21 4.8v10.4a1.8 1.8 0 0 1-1.8 1.8H9l-5 4v-4h.8A1.8 1.8 0 0 1 3 15.2V4.8A1.8 1.8 0 0 1 4.8 3Z"/></svg>
        <%= decision.comments_count %>
      </span>
    <% end %>
  </div>
</li>
