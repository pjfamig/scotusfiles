<%= turbo_stream_from :decisions %>

<section class="relative overflow-hidden border-b border-stone-200 bg-navy-900 text-white dark:border-white/10">
  <div class="absolute inset-0 opacity-[0.07] [background-image:radial-gradient(circle_at_1px_1px,white_1px,transparent_0)] [background-size:22px_22px]"></div>
  <div class="relative mx-auto max-w-[90rem] px-4 py-16 lg:px-8 lg:py-20">
    <p class="text-xs font-semibold tracking-[0.3em] text-gold-400 uppercase">Supreme Court of the United States</p>
    <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
      Read the Court’s opinions, then talk about them one sentence at a time.
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-stone-300">
      Every decision, converted from the official PDF into clean, readable text. Click any sentence to see what others think, or add your own note in the margin.
    </p>

    <%= form_with url: decisions_path, method: :get, class: "mt-10 max-w-2xl",
          data: { controller: "search", turbo_frame: "decisions", turbo_action: "advance" } do |form| %>
      <label for="q" class="sr-only">Search decisions</label>
      <div class="relative">
        <svg class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-stone-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"/></svg>
        <%= form.search_field :q, value: @query, id: "q", placeholder: "Search by case name, docket number, or holding…", autocomplete: "off",
              data: { action: "input->search#submit" },
              class: "w-full rounded-xl border-0 bg-white/10 py-3.5 pr-4 pl-12 text-base text-white ring-1 ring-white/20 placeholder:text-stone-400 focus:bg-white/15 focus:ring-2 focus:ring-gold-400 focus:outline-none" %>
      </div>
    <% end %>
  </div>
</section>

<div class="mx-auto max-w-[90rem] px-4 py-10 lg:px-8">
  <%= turbo_frame_tag "decisions", data: { turbo_action: "advance" } do %>
    <div class="flex flex-wrap items-center gap-3">
      <% if @query.present? %>
        <h2 class="text-lg font-semibold">
          <%= pluralize(@decisions.size, "result") %> for “<%= @query %>”
        </h2>
        <%= link_to "Clear search", decisions_path, class: "text-sm text-navy-600 underline-offset-4 hover:underline dark:text-gold-300" %>
      <% else %>
        <nav class="-mx-1 flex flex-wrap gap-1" aria-label="Terms">
          <% (@terms.presence || [ @term ]).each do |term| %>
            <%= link_to "OT #{term}", decisions_path(term: term),
                  class: class_names("rounded-full px-3.5 py-1.5 text-sm font-medium transition",
                    "bg-navy-800 text-white dark:bg-gold-400 dark:text-navy-950": term == @term,
                    "text-stone-600 hover:bg-stone-200/70 dark:text-stone-300 dark:hover:bg-white/10": term != @term) %>
          <% end %>
        </nav>
      <% end %>

      <% if current_user&.admin? %>
        <%= button_to admin_term_sync_path(@term), data: { turbo_frame: "_top" },
              class: "ml-auto inline-flex items-center gap-2 rounded-md border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-white dark:border-white/15 dark:text-stone-200 dark:hover:bg-white/5" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 4h4v4M20 4l-6 6M8 20H4v-4M4 20l6-6"/></svg>
          Sync OT <%= @term %> from supremecourt.gov
        <% end %>
      <% end %>
    </div>

    <% if @decisions.empty? %>
      <div class="mt-10 rounded-2xl border border-dashed border-stone-300 px-6 py-16 text-center dark:border-white/15">
        <p class="font-serif text-xl">No decisions here yet.</p>
        <p class="mt-2 text-sm text-stone-500 dark:text-stone-400">
          <% if @query.present? %>
            Try a different case name or docket number.
          <% else %>
            Run <code class="rounded bg-stone-200/70 px-1.5 py-0.5 text-xs dark:bg-white/10">bin/rails db:seed</code> or sign in as an admin and sync a term to import opinions.
          <% end %>
        </p>
      </div>
    <% else %>
      <% @decisions.group_by { |decision| decision.decided_on&.beginning_of_month }.each do |month, decisions| %>
        <section class="mt-10">
          <h2 class="sticky top-16 z-10 -mx-2 bg-paper/90 px-2 py-2 text-xs font-semibold tracking-[0.2em] text-stone-500 uppercase backdrop-blur dark:bg-navy-950/90 dark:text-stone-400">
            <%= month ? month.strftime("%B %Y") : "Undated" %>
          </h2>
          <ul class="mt-2 divide-y divide-stone-200 dark:divide-white/10">
            <%= render partial: "decisions/decision", collection: decisions %>
          </ul>
        </section>
      <% end %>
    <% end %>
  <% end %>
</div>
