<% home = @query.empty? && request.path == root_path %>
<% if @query.present? %>
  <% content_for :title, "Search results for “#{@query}”" %>
  <% noindex! %>
<% elsif !home %>
  <% content_for :title, "October Term #{@term} Supreme Court Opinions" %>
  <% content_for :description, term_meta_description(@term, @decisions.size) %>
  <% noindex! if @decisions.empty? %>
<% end %>
<% content_for :canonical, absolute_url(@query.present? ? decisions_path : term_listing_path(@term)) %>
<% content_for :head do %>
  <% if home %>
    <%= json_ld website_schema %>
  <% elsif @query.empty? %>
    <%= json_ld breadcrumb_schema([ [ "Decisions", root_path ], [ "October Term #{@term}", term_listing_path(@term) ] ]) %>
  <% end %>
<% end %>
<%= turbo_stream_from :decisions %>

<section class="border-b border-neutral-200 bg-gradient-to-b from-accent-50/70 to-white dark:border-neutral-800 dark:from-accent-500/10 dark:to-neutral-950">
  <div class="mx-auto max-w-[90rem] px-4 py-16 lg:px-8 lg:py-20">
    <p class="text-xs font-semibold tracking-[0.2em] text-accent-600 uppercase dark:text-accent-400">Supreme Court of the United States</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl">
      <% if home || @query.present? %>
        Read the Court’s opinions, then talk about them one sentence at a time.
      <% else %>
        Supreme Court opinions from October Term <%= @term %>
      <% end %>
    </h1>
    <p class="mt-5 max-w-2xl text-lg text-neutral-600 dark:text-neutral-400">
      Every decision, converted from the official PDF into clean, readable text. Click any sentence to see what others think, or add your own note in the margin.
    </p>

    <%= form_with url: decisions_path, method: :get, class: "mt-10 max-w-2xl",
          data: { controller: "search", turbo_frame: "decisions", turbo_action: "advance" } do |form| %>
      <label for="q" class="sr-only">Search decisions</label>
      <div class="relative">
        <svg class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m21 21-4.35-4.35M17 10.5a6.5 6.5 0 1 1-13 0 6.5 6.5 0 0 1 13 0Z"/></svg>
        <%= form.search_field :q, value: @query, id: "q", placeholder: "Search by case name, docket number, or holding…", autocomplete: "off",
              data: { action: "input->search#submit" },
              class: "w-full rounded-xl border border-neutral-300 bg-white py-3.5 pr-4 pl-12 text-base text-neutral-950 shadow-sm transition-shadow duration-150 placeholder:text-neutral-400 focus:border-accent-500 focus:ring-4 focus:ring-accent-500/15 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white dark:focus:border-accent-400 dark:focus:ring-accent-400/20" %>
      </div>
    <% end %>
  </div>
</section>

<div class="mx-auto max-w-[90rem] px-4 py-10 lg:px-8">
  <%= turbo_frame_tag "decisions", data: { turbo_action: "advance" } do %>
    <div class="flex flex-wrap items-center gap-3">
      <% if @query.present? %>
        <h2 class="text-lg font-semibold">
          <%= pluralize(@decisions.size, "result") %> for “<%= @query %>”
        </h2>
        <%= link_to "Clear search", root_path, class: "text-sm text-accent-600 underline-offset-4 hover:underline dark:text-accent-400" %>
      <% else %>
        <nav class="-mx-1 flex flex-wrap gap-1" aria-label="Terms">
          <% (@terms.presence || [ @term ]).each do |term| %>
            <%= link_to "OT #{term}", term_listing_path(term),
                  title: "October Term #{term} opinions", aria: { current: ("page" if term == @term) },
                  data: { turbo_frame: "_top" },
                  class: class_names("rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors duration-150",
                    "bg-neutral-950 text-white dark:bg-white dark:text-neutral-950": term == @term,
                    "text-neutral-600 hover:bg-neutral-100 hover:text-neutral-950 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white": term != @term) %>
          <% end %>
        </nav>
      <% end %>

      <% if current_user&.admin? %>
        <%= button_to admin_term_sync_path(@term), data: { turbo_frame: "_top" },
              class: "ml-auto inline-flex cursor-pointer items-center gap-2 rounded-md border border-neutral-300 px-3 py-1.5 text-sm font-medium transition-colors duration-150 hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-900" do %>
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 4h4v4M20 4l-6 6M8 20H4v-4M4 20l6-6"/></svg>
          Sync OT <%= @term %> from supremecourt.gov
        <% end %>
      <% end %>
    </div>

    <% if @query.empty? && @decisions.any? %>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-neutral-600 dark:text-neutral-400">
        <%= pluralize(@decisions.size, "opinion") %> from the Supreme Court’s October Term <%= @term %>
        (<%= @term %>–<%= (@term + 1).to_s.last(2) %>), newest first, each converted from the Court’s official PDF
        into searchable text with its holding, majority opinion, concurrences, and dissents.
      </p>
    <% end %>

    <% if @decisions.empty? %>
      <div class="mt-10 rounded-2xl border border-dashed border-neutral-300 px-6 py-16 text-center dark:border-neutral-700">
        <p class="text-lg font-semibold">No decisions here yet.</p>
        <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
          <% if @query.present? %>
            Try a different case name or docket number.
          <% else %>
            Run <code class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs dark:bg-neutral-900">bin/rails db:seed</code> or sign in as an admin and sync a term to import opinions.
          <% end %>
        </p>
      </div>
    <% else %>
      <% @decisions.group_by { |decision| decision.decided_on&.beginning_of_month }.each do |month, decisions| %>
        <section class="mt-10">
          <h2 class="sticky top-14 z-10 border-b border-neutral-200 bg-white/90 py-2 text-xs font-semibold tracking-[0.2em] text-neutral-500 uppercase backdrop-blur-md dark:border-neutral-800 dark:bg-neutral-950/90 dark:text-neutral-400">
            <%= month ? month.strftime("%B %Y") : "Undated" %>
          </h2>
          <ul class="divide-y divide-neutral-200 dark:divide-neutral-800">
            <%= render partial: "decisions/decision", collection: decisions %>
          </ul>
        </section>
      <% end %>
    <% end %>
  <% end %>
</div>
