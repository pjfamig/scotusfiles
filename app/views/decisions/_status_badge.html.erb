<% case decision.status %>
<% when "pending", "importing" %>
  <span class="inline-flex items-center gap-1.5 border border-neutral-300 px-2 py-1 text-xs font-medium text-neutral-600 dark:border-neutral-700 dark:text-neutral-300">
    <span class="size-1.5 animate-pulse bg-neutral-950 dark:bg-white"></span>
    Formatting
  </span>
<% when "failed" %>
  <span class="inline-flex items-center border border-red-600 px-2 py-1 text-xs font-medium text-red-700 dark:text-red-400">Import failed</span>
<% end %>
