<% case decision.status %>
<% when "pending", "importing" %>
  <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-800 dark:bg-amber-500/15 dark:text-amber-200">
    <span class="size-1.5 animate-pulse rounded-full bg-amber-500"></span>
    Formatting
  </span>
<% when "failed" %>
  <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-1 text-xs font-medium text-red-700 dark:bg-red-500/15 dark:text-red-200">Import failed</span>
<% end %>
