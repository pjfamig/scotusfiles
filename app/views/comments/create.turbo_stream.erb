<% if @passage %>
  <%= turbo_stream.append dom_id(@passage, :comments), partial: "comments/comment", locals: { comment: @comment } %>
<% end %>
<%= turbo_stream.replace "comment_form", partial: "comments/form", locals: { decision: @decision, passage: @passage, comment: Comment.new } %>
<%= turbo_stream.replace "annotation_counts", partial: "decisions/annotation_counts", locals: { decision: @decision } %>
