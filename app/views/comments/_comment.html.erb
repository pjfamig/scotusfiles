<li id="<%= dom_id(comment) %>" class="group flex gap-3"
    data-controller="ownership" data-ownership-author-id-value="<%= comment.user_id %>">
  <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-navy-700 text-xs font-semibold text-white dark:bg-gold-400 dark:text-navy-950"><%= comment.user.initials %></span>
  <div class="min-w-0 flex-1">
    <p class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400">
      <span class="font-semibold text-stone-800 dark:text-stone-200"><%= comment.user.name %></span>
      <%= time_tag comment.created_at, "#{time_ago_in_words(comment.created_at)} ago" %>
      <%= button_to "Delete", decision_comment_path(comment.decision, comment), method: :delete,
            form: { hidden: true, data: { turbo_confirm: "Delete this comment?", ownership_target: "control" }, class: "ml-auto" },
            class: "text-xs text-stone-400 opacity-0 group-hover:opacity-100 hover:text-red-600 focus:opacity-100" %>
    </p>
    <p class="mt-1 text-sm leading-relaxed whitespace-pre-line text-stone-800 dark:text-stone-200"><%= comment.body %></p>
  </div>
</li>
