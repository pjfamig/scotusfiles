<li id="<%= dom_id(comment, :discussion) %>">
  <% if comment.passage %>
    <button type="button" data-action="reader#jump" data-reader-key-param="<%= comment.passage.key %>"
            class="block w-full rounded-lg border-l-2 border-gold-400 bg-stone-50 px-3 py-2 text-left font-serif text-sm leading-snug text-stone-600 hover:bg-gold-200/40 dark:bg-white/5 dark:text-stone-300 dark:hover:bg-gold-400/10">
      “<%= truncate(comment.passage.text, length: 140, separator: " ") %>”
    </button>
  <% end %>
  <div class="mt-2 text-sm">
    <p class="flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400">
      <span class="font-semibold text-stone-800 dark:text-stone-200"><%= comment.user.name %></span>
      <%= time_tag comment.created_at, "#{time_ago_in_words(comment.created_at)} ago" %>
    </p>
    <p class="mt-1 line-clamp-4 whitespace-pre-line text-stone-700 dark:text-stone-300"><%= comment.body %></p>
  </div>
</li>
