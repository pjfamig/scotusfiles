<li id="<%= dom_id(comment, :discussion) %>">
  <% if comment.passage %>
    <button type="button" data-action="reader#jump" data-reader-key-param="<%= comment.passage.key %>"
            class="block w-full cursor-pointer border-l-2 border-accent-500 px-3 py-1.5 text-left text-sm leading-snug text-neutral-600 hover:bg-accent-50 dark:border-accent-400 dark:text-neutral-300 dark:hover:bg-accent-400/10">
      “<%= truncate(comment.passage.text, length: 140, separator: " ") %>”
    </button>
  <% end %>
  <div class="mt-2 text-sm">
    <p class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
      <span class="font-semibold text-neutral-950 dark:text-white"><%= comment.user.name %></span>
      <%= time_tag comment.created_at, "#{time_ago_in_words(comment.created_at)} ago" %>
    </p>
    <p class="mt-1 line-clamp-4 whitespace-pre-line text-neutral-800 dark:text-neutral-300"><%= comment.body %></p>
  </div>
</li>
