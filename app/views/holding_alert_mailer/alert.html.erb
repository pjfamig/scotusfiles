<div style="max-width: 560px; margin: 0 auto; padding: 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; color: #171717; line-height: 1.55;">
  <p style="margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #737373;">Holding alert!</p>
  <h1 style="margin: 8px 0 4px; font-size: 22px; line-height: 1.3;"><%= @decision.title %></h1>
  <p style="margin: 0; font-size: 13px; color: #737373;">
    No. <%= @decision.docket_number %><% if @decision.decided_on %> · Decided <%= @decision.decided_on.to_fs(:long) %><% end %>
  </p>

  <p style="margin: 20px 0; font-size: 16px;"><%= @decision.holding_summary || "The Supreme Court has released its opinion in this case." %></p>

  <p style="margin: 24px 0;">
    <%= link_to "Read and comment on the full opinion", decision_url(@decision),
          style: "display: inline-block; padding: 10px 16px; border-radius: 8px; background: #171717; color: #ffffff; font-weight: 600; text-decoration: none;" %>
  </p>

  <p style="margin: 32px 0 0; padding-top: 16px; border-top: 1px solid #e5e5e5; font-size: 12px; color: #737373;">
    You’re getting this because you have a SCOTUSfiles account.
    <%= link_to "Turn off Holding alerts", @preferences_url, style: "color: #737373;" %>.
  </p>
</div>
